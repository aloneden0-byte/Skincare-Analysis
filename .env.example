# Supabase project settings (Settings -> API in your Supabase dashboard)
# Safe to expose in the client bundle: security is enforced by Row Level Security
# policies in supabase/schema.sql, not by keeping this key secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only needed locally to run supabase/seed/run-seed.ts. NEVER commit this key
# or expose it in client code — it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, local dev convenience only: auto sign-in on `npm run dev` with an
# existing test account so you don't have to click through the login screen
# every time. Only active in dev builds (import.meta.env.DEV) — never wired
# into the production build, so leave these unset for CI/GitHub Actions.
VITE_DEV_AUTO_LOGIN_EMAIL=
VITE_DEV_AUTO_LOGIN_PASSWORD=
